{
  "expo": {
    "name": "EscudoChild",
    "slug": "EscudoChild",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "escudochild",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permitir que o aplicativo use o reconhecimento de fala para interagir com a criança.",
        "NSMicrophoneUsageDescription": "Permitir que o aplicativo use o microfone para captação de voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/robot-icon1.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.escudo.EscudoChild"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/robot-icon1.jpg",
          "imageWidth": 120
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a397f5c1-44a6-488d-bfa3-e1c4e0581abe"
      }
    },
    "owner": "escudo"
  }
}